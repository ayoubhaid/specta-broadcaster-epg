{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayoubhaid/specta-broadcaster-epg/blob/main/schema/schedule-v1.schema.json",
  "title": "Specta Provider Schedule Feed v1",
  "type": "object",
  "required": ["schemaVersion", "provider", "providerName", "sourceUrl", "region", "timezone", "generatedAt", "coverage", "channels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "providerName": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "region": { "type": "string" },
    "timezone": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "coverage": {
      "type": "object",
      "required": ["daysRequested", "channelsFound", "programmesFound", "successfulRequests", "failedRequests"],
      "properties": {
        "daysRequested": { "type": "integer", "minimum": 1 },
        "channelsFound": { "type": "integer", "minimum": 0 },
        "programmesFound": { "type": "integer", "minimum": 0 },
        "successfulRequests": { "type": "integer", "minimum": 0 },
        "failedRequests": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "region", "programmes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "region": { "type": "string" },
          "canonicalChannelId": { "type": "string" },
          "programmes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "description", "start", "end", "startEpochSeconds", "endEpochSeconds", "source"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "start": { "type": "string", "format": "date-time" },
                "end": { "type": "string", "format": "date-time" },
                "startEpochSeconds": { "type": "integer" },
                "endEpochSeconds": { "type": "integer" },
                "source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
